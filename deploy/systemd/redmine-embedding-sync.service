# 同期バッチ（Redmine -> pgvector）の oneshot ユニット例。redmine-embedding-sync.timer から起動する。
# 置き場所: /etc/systemd/system/redmine-embedding-sync.service
# <...> と下記の既定パスは自環境に合わせて書き換える。
[Unit]
Description=redmine-embedding sync batch
# DB は docker/ の pgvector コンテナが標準。docker.service の後に起動する(順序のみ。DB 未起動でも Restart で回復する)
After=network.target docker.service

[Service]
Type=oneshot
User=redmine-embedding
Group=redmine-embedding
# flock のロックファイル置き場（/run/redmine-embedding/ を実行ユーザー所有で作る。/run 直下は非特権では書けない）
RuntimeDirectory=redmine-embedding
# ユニット停止時にディレクトリとロックを消さない（手動実行中に timer 起動が失敗して止まっても、手動実行とのロック共有を保つため）
RuntimeDirectoryPreserve=yes
WorkingDirectory=/opt/redmine-embedding
# 必要なのは REDMINE_URL / REDMINE_API_KEY / DATABASE_URL。管理者 API キーを含むので、MCP とは別ファイルにするのを推奨（deploy/README.md）。
EnvironmentFile=/etc/redmine-embedding/sync.env
# モデルは取得済みにして、実行時に Hugging Face へ問い合わせない（推奨）。初回だけ 0 にして取得する。
Environment=HF_HUB_OFFLINE=1
# 多重起動防止: flock で排他（取れなければ即終了 = -n）。手動実行（redmine-embedding-batch sync を直接）と排他したいときは、手動側も
# 同じ /run/redmine-embedding/sync.lock を flock で取る（初回のサービス起動まではディレクトリが無いので先に作る。docs/install.md §7.2）。取れないときに unit を failed にしたくなければ -E 0 を足す。
# 既定は差分同期。削除の反映は既定で dry-run。実際に消すには末尾に --apply-deletions を付ける
# （または settings の reconcile_apply_deletions を true にする）。内容を確認してから有効にすること。
ExecStart=/usr/bin/flock -n /run/redmine-embedding/sync.lock \
  /opt/redmine-embedding/.venv/bin/redmine-embedding-batch --env prod sync
# 長時間化の保険（初回の全件取り込みでは延ばす）。
TimeoutStartSec=6h
