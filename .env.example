# 設定の基本は config/settings*.json（config/settings.example.json 参照）。
# 例外: git に載せない項目（URL・パスワード・API キー）だけここ（.env）か export で指定する。
# 同じ項目が両方にあれば export が優先。JSON の項目はここに書いても無視される。
REDMINE_URL=
REDMINE_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/redmine_embedding

# docker/compose.yaml 用（POSTGRES_PASSWORD は必須。値を自分で決める）
POSTGRES_USER=redmine_embedding
POSTGRES_PASSWORD=
POSTGRES_DB=redmine_embedding
# POSTGRES_BIND=127.0.0.1
# POSTGRES_PORT=5432
