{
  "$schema": "../src/redmine_embedding/common/settings.schema.json",
  "embedding_model": "cl-nagoya/ruri-v3-130m",
  "embedding_device": "cpu",
  "redmine_timeout": 30.0,
  "redmine_max_retries": 3,
  "reconcile_apply_deletions": false,
  "chunk_max_chars": 1000,
  "sync_overlap_minutes": 10,
  "embed_flush_size": 64,
  "embedding_batch_size": 16,
  "attachment_max_bytes": 2097152,
  "attachment_text_max_chars": 200000,
  "redmine_request_interval": 0.0,
  "search_top_k": 50,
  "visible_projects_cache_ttl": 60.0,
  "visible_projects_cache_max_entries": 1000,
  "search_max_rounds": 3,
  "search_check_max_requests": 100,
  "search_check_workers": 8,
  "search_default_limit": 10,
  "search_check_cache_ttl": 0.0,
  "search_check_cache_max_entries": 10000,
  "mcp_host": "127.0.0.1",
  "mcp_port": 8000,
  "search_timeout_seconds": 20.0,
  "search_max_limit": 50,
  "search_excerpt_chars": 300,
  "search_excerpt_mask_credentials": true,
  "mcp_db_pool_max": 4,
  "mcp_embed_concurrency": 2,
  "mcp_redmine_timeout": 10.0,
  "mcp_redmine_max_retries": 1,
  "mcp_public_base_url": "",
  "mcp_public_path": "/mcp-search",
  "mcp_oauth_scopes": ["view_issues", "view_wiki_pages", "view_news", "view_time_entries", "view_files", "view_project"],
  "mcp_oauth_introspect_cache_ttl": 30.0,
  "mcp_oauth_access_token_ttl": 3600,
  "mcp_oauth_refresh_token_ttl": 2592000,
  "mcp_oauth_client_retention_days": 90,
  "mcp_oauth_cleanup_apply": false,
  "mcp_oauth_cleanup_interval": 3600,
  "mcp_oauth_max_clients": 1000,
  "mcp_oauth_max_pending_requests": 1000,
  "mcp_oauth_rate_limit_per_minute": 20,
  "mcp_oauth_max_clients_per_ip": 50,
  "mcp_oauth_max_pending_per_ip": 20,
  "mcp_oauth_refresh_grace_seconds": 30
}
